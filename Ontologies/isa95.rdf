    <rdfs:comment>The material class property(s) of this material class.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#hasPropertiesOf</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__description">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_LangStringSet_v1"/>
