    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordTemplate;1#effectiveTimestamp</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
