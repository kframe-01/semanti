  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1__action">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1"/>
