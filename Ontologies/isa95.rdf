    <rdfs:comment>This parent material class is whole of the child material class(s) as the part.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#IsAssembledFrom</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__hasPropertiesOf">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClassProperty_v1"/>
