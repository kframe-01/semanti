    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_LangStringSet_v1"/>
    <rdfs:label>Description</rdfs:label>
    <rdfs:comment>Additional information about the operations record entry template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#description</isa95:sourceDtmi>
    <isa95:dtdlType>Component</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__informationObject">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Information object</rdfs:label>
    <rdfs:comment>An embedded information object. If data is referenced in this operations record entry template, the attribute is not used. The format of the information object is specified in this operations record specification template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#informationObject</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__informationObjectID">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Information object ID</rdfs:label>
    <rdfs:comment>The reference to external data (information object) which is stored external to this operations record entry template. If data is embedded in this operations record entry template, the attribute is not used. The format of the reference is specified in this operations record specification template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#informationObjectID</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__informationObjectType">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Information object type</rdfs:label>
    <rdfs:comment>Identifies the type of information object type that an operations record entry template is based upon. The allowed information object types are defined in the operations record specification template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#informationObjectType</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__effectiveTimestamp">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>Effective timestamp</rdfs:label>
    <rdfs:comment>The date and time that the operations record entry template was/is effective. If no effective timestamp is provided with operations record entry template, the effective timestamp is represented by the effective timestamp attribute in the operations record template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#effectiveTimestamp</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__recordTimestamp">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>Record timestamp</rdfs:label>
    <rdfs:comment>The date and time the publisher recorded / transacted the action. If no entry is provided, the record timestamp is the record timestamp attribute in the operations record template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#recordTimestamp</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__contains">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:label>Contains</rdfs:label>
    <rdfs:comment>This parent operations record specification template is whole of the child operations record specification template(s) as the part</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#contains</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__description">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_LangStringSet_v1"/>
    <rdfs:label>Description</rdfs:label>
    <rdfs:comment>Contains additional information and description of the operations record specification template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#description</isa95:sourceDtmi>
    <isa95:dtdlType>Component</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__informationObjectType">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Information object type</rdfs:label>
    <rdfs:comment>Permitted set of information objects allowed in the operations record template occurrence. An operations record entry template contains the reference to the information object for operations record template. NOTE 1 An unconstrained set of values can be represented with the * entry</rdfs:comment>
    <isa95:sourceComment>Since DTDLv2 doesn't support array, use strings like [Equipment, Personnel] or [JobList]</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#informationObjectType</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__informationObjectTypeMultiplicity">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Information object type multiplicity</rdfs:label>
    <rdfs:comment>The range of the information object(s) in operations record entry template allowed in the operations record template occurrence. If no limit is explicitly specified, the unbounded keyword is specified. If no multiplicity entry is specified, this is equivalent to no constraint. EXAMPLE 2 {Min: 0, Max: Unbounded}</rdfs:comment>
    <isa95:sourceComment>Samples: {Min: 1, Max: 1}, Min:1, Max: Unbounded}</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#informationObjectTypeMultiplicity</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__action">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Action</rdfs:label>
    <rdfs:comment>The permitted set of actions applied to the operations record entry template object in the operations record template by the publisher. Defined values for action are added, changed, deleted, and observed. If no action is specified, this is equivalent to all actions being allowed</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#action</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1__actionMultiplicity">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Action multiplicity</rdfs:label>
    <rdfs:comment>The range of actions allowed to be represented in the operations record template occurrence.If no limit is explicitly specified, the unbounded keyword is specified. If no multiplicity entry is specified, this is equivalent to no constraint. EXAMPLE 3 {Min: 0, Max: Unbounded}</rdfs:comment>
    <isa95:sourceComment>Samples: {Min: 1, Max: 1}, Min:1, Max: Unbounded}</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1#actionMultiplicity</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1__recordsActionOn">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
    <rdfs:label>Records action on</rdfs:label>
    <rdfs:comment>This operations record template acts as a container for operations record entry template (s) applying a common action for each operations record template</rdfs:comment>
    <isa95:sourceComment>Cardiniality is 1..*</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordTemplate;1#recordsActionOn</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1__specifiedBy">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1"/>
    <rdfs:label>Specified by</rdfs:label>
