<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:isa95="https://w3id.org/trumpf/isa95/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <owl:Ontology rdf:about="https://w3id.org/trumpf/isa95/">
    <rdfs:label>ISA-95 ontology converted from DTDL</rdfs:label>
    <dcterms:title>ISA-95 reference ontology</dcterms:title>
    <dcterms:source>ontology/isa95/source/ISA95</dcterms:source>
    <owl:versionInfo>Generated from DTDL source</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1">
    <rdfs:label>Base ISA-95 model</rdfs:label>
    <rdfs:comment>Abstract base model for all ISA-95 models</rdfs:comment>
    <isa95:sourceComment>Not part of the ISA-95 standard</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:BaseModel;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1">
    <rdfs:label>Hierarchy scope</rdfs:label>
    <rdfs:comment>The hierarchy scope identifies where the exchanged information fits within the role-based equipment hierarchy. It defines the scope of the exchanged information, such as a site or area for ANSI/ISA-95.00.02-2018 – 19 –which the information is relevant. The hierarchy scope identifies the associated instance in the role-based equipment hierarchy. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:HierarchyScope;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1">
    <rdfs:label>Material class</rdfs:label>
    <rdfs:comment>A representation of groupings of material definitions for a definite purpose such as manufacturing operations definition, scheduling, capability, and performance shall be presented as a material class. A material definition shall belong to zero or more material classes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClass_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClassProperty_v1">
    <rdfs:label>Material class property</rdfs:label>
    <rdfs:comment>Properties of a material class shall be presented as material class properties. A material class may define zero or more material class properties. A material class property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClassProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1">
    <rdfs:label>Material definition</rdfs:label>
    <rdfs:comment>A representation of a material with similar characteristics for the purpose of manufacturing operations definition, scheduling, capability and performance shall be presented as a material definition</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinitionProperty_v1">
    <rdfs:label>Material definition property</rdfs:label>
    <rdfs:comment>Properties of a material definition shall be presented as material definition properties. A material definition may define zero or more material definition properties. A material definition property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialLot_v1">
    <rdfs:label>Material lot</rdfs:label>
    <rdfs:comment>A uniquely identified specific amount of material, either countable or weighable shall be presented as a material lot. A material lot describes the planned or actual total quantity or amount of material available, its current state, and its specific property values</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialLot;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialLotProperty_v1">
    <rdfs:label>Material lot property</rdfs:label>
    <rdfs:comment>Properties of a material lot shall be presented as material lot properties. Each material can have unique values for zero or more material lot properties, such as a specific pH value for the specific material lot, or a specific density for the material lot</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialLotProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialSublot_v1">
    <rdfs:label>Material sublot</rdfs:label>
    <rdfs:comment>Each separately identifiable quantity of the same material lot shall be presented as a material sublot. A material lot may be stored in separately identifiable quantities. All material sublots are part of the same material lot, so they have the material lot’s property values. A material sublot may be just a single item</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialSublot;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationalLocation_v1">
    <rdfs:label>Operational location</rdfs:label>
    <rdfs:comment>A logical or physical location where a material lot, material sublot, equipment, physical asset or person is located or expected to be located shall be presented as an operational location. Operational locations may be made up of other operational locations.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationalLocation;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationalLocationClass_v1">
    <rdfs:label>Operational location class</rdfs:label>
    <rdfs:comment>A representation of a grouping of operational locations with similar characteristics for a definite purpose such as manufacturing operations definition, scheduling, capability and performance shall be presented as an operational location class. Any operational location may be a member of zero or more operational location classes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationalLocationClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationalLocationClassProperty_v1">
    <rdfs:label>Operational location class property</rdfs:label>
    <rdfs:comment>Properties of an operational location class shall be defined as operational location class property(s). An operational location class property may contain nested operational location class property(s). An operational location class property may have zero or more operational location property(s) mapping to it.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationalLocationClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationalLocationProperty_v1">
    <rdfs:label>Operational location property</rdfs:label>
    <rdfs:comment>Properties of operational locations shall be presented as operational location properties. Anoperational location shall have zero or more operational location properties. These specify the current property values of the operational location for the associated operational location class property. Operational location properties may include a unit of measure.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationalLocationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentCapability_v1">
    <rdfs:label>Equipment capability</rdfs:label>
    <rdfs:comment>A representation of the capability of equipment or equipment classes that is committed, available, or unattainable for a specific time shall be presented as an equipment capability.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentCapabilityProperty_v1">
    <rdfs:label>Equipment capability property</rdfs:label>
    <rdfs:comment>Specific properties that are required for an equipment capability shall be presented as equipment capability properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentCapabilityProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialCapability_v1">
    <rdfs:label>Material capability</rdfs:label>
    <rdfs:comment>A representation of the capability of material that is committed, available, or unattainable for a specific time shall be presented as a material capability.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialCapabilityProperty_v1">
    <rdfs:label>Material capability property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a material capability shall be presented as material capability properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialCapabilityProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsCapability_v1">
    <rdfs:label>Operations capability</rdfs:label>
    <rdfs:comment>A collection of personnel capabilities, equipment capabilities, physical asset capabilities, material capabilities, process segment capabilities, and operations segment capabilities for a given slice of time (past, current, or future), shall be presented as an operations capability.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsSegmentCapability_v1">
    <rdfs:label>Operations segment capability</rdfs:label>
    <rdfs:comment>Other information related to the capability operations made shall be presented as segment data.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsSegmentCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelCapability_v1">
    <rdfs:label>Personnel capability</rdfs:label>
    <rdfs:comment>The capability of persons or personnel classes that is committed, available, or unattainable for a defined time shall be presented as a personnel capability</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelCapabilityProperty_v1">
    <rdfs:label>Personnel capability property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a personnel capability shall be presented as personnel capability properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelCapabilityProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetCapability_v1">
    <rdfs:label>Physical Asset capability</rdfs:label>
    <rdfs:comment>A representation of the capability of a physical asset or physical asset class that is committed, available, or unattainable for a specific time shall be presented as a physical asset capability. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetCapabilityProperty_v1">
    <rdfs:label>Physical Asset capability property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a physical asset capability shall be presented as physical asset capability properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetCapabilityProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProcessSegmentCapability_v1">
    <rdfs:label>Process segment capability</rdfs:label>
    <rdfs:comment>A representation of a logical grouping of personnel resources, equipment resources, physical asset resources, and material that is committed, available, or unavailable for a given process segment for a specific time shall be presented as a process segment capability.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProcessSegmentCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentSpecification_v1">
    <rdfs:label>Equipment specification</rdfs:label>
    <rdfs:comment>Equipment resources that are required for a operations segment shall be presented as equipment specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentSpecificationProperty_v1">
    <rdfs:label>Equipment specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for equipment specifications shall be presented as equipment specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialSpecification_v1">
    <rdfs:label>Material specification</rdfs:label>
    <rdfs:comment>Material resources that are required for a operations segment shall be presented as material specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialSpecificationProperty_v1">
    <rdfs:label>Material specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for material segment specifications shall be presented as material segment specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsDefinition_v1">
    <rdfs:label>Operations definition</rdfs:label>
    <rdfs:comment>The resources required to perform a specified operation shall be presented as an operations definition</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsMaterialBill_v1">
    <rdfs:label>Operations material bill</rdfs:label>
    <rdfs:comment>The collection of all material used in the operation, independent of the process segment the material is used in, shall be presented as operations material bills.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsMaterialBill;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsMaterialBillItem_v1">
    <rdfs:label>Operations material bill item</rdfs:label>
    <rdfs:comment>The items that make up the complete operations material bill shall be presented as operations material bill items.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsMaterialBillItem;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsSegment_v1">
    <rdfs:label>Operations segment</rdfs:label>
    <rdfs:comment>The information needed to quantify a segment for a specific operation shall be presented as an operations segment. An operations segment identifies, references, or corresponds to a process segment. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsSegment;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsSegmentDependency_v1">
    <rdfs:label>Segment dependency</rdfs:label>
    <rdfs:comment>Operations dependencies that are independent of any particular product or operations task shall be presented as segment dependencies.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsSegmentDependency;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ParameterSpecification_v1">
    <rdfs:label>Parameter specification</rdfs:label>
    <rdfs:comment>Specific parameters required for an operations segment shall be presented as parameter specifications. An operations segment may have an associated set of zero or more parameter specifications.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ParameterSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelSpecification_v1">
    <rdfs:label>Personnel specification</rdfs:label>
    <rdfs:comment>Personnel resources that are required for a operations segment shall be presented as personnel specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelSpecificationProperty_v1">
    <rdfs:label>Personnel specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for personnel specifications shall be presented as personnel specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetSpecification_v1">
    <rdfs:label>Physical Asset specification</rdfs:label>
    <rdfs:comment>Physical asset resources that are required for a operations segment shall be presented as physical asset specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetSpecificationProperty_v1">
    <rdfs:label>Physical Asset specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for physical asset specifications shall be presented as physical asset specification property(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEvent_v1">
    <rdfs:label>Operations event</rdfs:label>
    <rdfs:comment>Large numbers of real-world events occur in any given manufacturing system. Only some real-world events are associated with manufacturing operations management activities and functions. The subset of those real-world events that require notification of process context specific information exchanges of this standard shall be defined as operations events. Operations events may be generated by any Level 4 or Level 3 function or activity</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEvent;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventClass_v1">
    <rdfs:label>Operations event class</rdfs:label>
    <rdfs:comment>An operations event class is a representation of groupings of operations event definitions</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventClassProperty_v1">
    <rdfs:label>Operations event class property</rdfs:label>
    <rdfs:comment>Properties of an operations event class shall be listed as operations event class properties. An operations event class shall be further characterized through zero or more operations event class properties. Operations event class properties may contain nested operations event class properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventClassRecordSpecification_v1">
    <rdfs:label>Operations event class record specification</rdfs:label>
    <rdfs:comment>Operations event classes define common structures of operations event definitions using operations event class record specifications. Operations event definitions as members of an operations event class that contain operations event class record specifications must support the record specification entries indicated in the operations event class. The structure and semantics of the operations event class record specification is the same as the operations event definition record specification</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventClassRecordSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventDefinition_v1">
    <rdfs:label>Operations event definition</rdfs:label>
    <rdfs:comment>Definition and structure of operations event occurrences shall be shown as an operations event definition. The operations event definition of an operations event is identified by the definition ID attribute in the operations event occurrence. Those constructing or interpreting an operations event obtain and validate the structure and definition from the operations event definition</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventDefinitionProperty_v1">
    <rdfs:label>Operations event definition property</rdfs:label>
    <rdfs:comment>Properties of an operations event definition shall be defined as operations event definition properties. An operations event definition shall be further characterized through zero or more operations event definition properties. Operations event definition properties may contain nested operations event definition properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventDefinitionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventDefinitionRecordSpecification_v1">
    <rdfs:label>Operations event definition record specification</rdfs:label>
    <rdfs:comment>Specification of the allowed content of operations event record shall be defined as the operations event definition record specification. Information object contents in an operations event vary depending on the process context of the operations event. The operations event definition record specification describes and specifies the information objects and associated actions that are allowed in the operations event occurrence. The publisher/sender shall follow this specification to construct the message</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventProperty_v1">
    <rdfs:label>Operations event property</rdfs:label>
    <rdfs:comment>Properties of an operations event shall be defined as operations event properties. An operations event shall be further characterized through zero or more operations event properties. Operations event properties may contain nested operations event properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventRecord_v1">
    <rdfs:label>Operations event record</rdfs:label>
    <rdfs:comment>The bundle of operations event record entry objects that are pertinent to the real-world MOM event shall be defined as an operations event record</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventRecord;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsEventRecordEntry_v1">
    <rdfs:label>Operations event record entry</rdfs:label>
    <rdfs:comment>The operations event record entry object shall be a single information object and any third-party manufacturing operations message profile within an operations event record. There shall be one or more operations event record entry objects in an operations event record. The relationships and their roles in an operations event record entry are defined in the operations record specification</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsEventRecordEntry;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentActual_v1">
    <rdfs:label>Equipment actual</rdfs:label>
    <rdfs:comment>An identification of an equipment capability used during a specified segment shall be presented as an equipment actual.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentActual;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceActual_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentActualProperty_v1">
    <rdfs:label>Equipment actual property</rdfs:label>
    <rdfs:comment>Specific properties that are required for an equipment actual shall be presented as equipment actual properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentActualProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialActual_v1">
    <rdfs:label>Material actual</rdfs:label>
    <rdfs:comment>An identification of a material that was used in the operations request shall be presented as a material actual.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialActual;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceActual_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialActualProperty_v1">
    <rdfs:label>Material actual property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a material actual shall be presented as material actual properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialActualProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsPerformance_v1">
    <rdfs:label>Operations performance</rdfs:label>
    <rdfs:comment>The performance of the requested manufacturing requests shall be presented as an operations performance.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsPerformance;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsResponse_v1">
    <rdfs:label>Operations response</rdfs:label>
    <rdfs:comment>The responses from manufacturing that are associated with an operations request shall be presented as operations responses.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsResponse;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelActual_v1">
    <rdfs:label>Personnel actual</rdfs:label>
    <rdfs:comment>An identification of a personnel capability used during a specified segment response shall be presented as personnel actual.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelActual;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceActual_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelActualProperty_v1">
    <rdfs:label>Personnel actual property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a personnel actual shall be presented as personnel actual properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelActualProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetActual_v1">
    <rdfs:label>Physical Asset actual</rdfs:label>
    <rdfs:comment>An identification of a physical asset capability used during a specified segment shall be presented as a physical asset actual.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetActual;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceActual_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetActualProperty_v1">
    <rdfs:label>Physical Asset actual property</rdfs:label>
    <rdfs:comment>Specific properties that are required for a physical asset actual shall be presented as physical asset actual properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetActualProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SegmentData_v1">
    <rdfs:label>Segment data</rdfs:label>
    <rdfs:comment>Other information related to the actual operations made shall be presented as segment data.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SegmentData;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SegmentResponse_v1">
    <rdfs:label>Segment response</rdfs:label>
    <rdfs:comment>Information on a segment of an operations response shall be presented as a segment response.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SegmentResponse;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1">
    <rdfs:label>Operations record entry template</rdfs:label>
    <rdfs:comment>The operations record entry template object shall be a single information object as an object defined in this part and Part 4 of this standard, and any third-party manufacturing operations message profile within an operations record template. There shall be one or more operations record entry template objects in an operations event record template</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordSpecificationTemplate_v1">
    <rdfs:label>Operations record specification template</rdfs:label>
    <rdfs:comment>Specification of the permitted content and form of objects in an operations record template shall be defined in an associated operations record specification template</rdfs:comment>
    <isa95:sourceComment>Abstract - According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordTemplate_v1">
    <rdfs:label>Operations record template</rdfs:label>
    <rdfs:comment>The bundle of operations record entry template objects pertinent to a specified real-world manufacturing recording activity shall be defined as an operations record template</rdfs:comment>
    <isa95:sourceComment>Abstract - According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordTemplate;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentRequirement_v1">
    <rdfs:label>Equipment requirement</rdfs:label>
    <rdfs:comment>The identification of the number, type, duration, and scheduling of specific equipment and equipment classifications or equipment constraints needed to support the c urrent operations request shall be presented as an equipment requirement</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsTestRequirement_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentRequirementProperty_v1">
    <rdfs:label>Equipment requirement property</rdfs:label>
    <rdfs:comment>Specific properties that are required for equipment requirements shall be presented as equipment requirement properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentRequirementProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialRequirement_v1">
    <rdfs:label>Material requirement</rdfs:label>
    <rdfs:comment>An identification of a material that is expected to be used in the operations request shall be presented as a material requirement</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsTestRequirement_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialRequirementProperty_v1">
    <rdfs:label>Material requirement property</rdfs:label>
    <rdfs:comment>Specific properties that are required for material requirements shall be presented as material requirement properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialRequirementProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRequest_v1">
    <rdfs:label>Operations request</rdfs:label>
    <rdfs:comment>A request for an element of an operation schedule shall be presented as an operations request.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRequest;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsSchedule_v1">
    <rdfs:label>Operations schedule</rdfs:label>
    <rdfs:comment>A request for operations to be performed shall be presented as an operations schedule.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsSchedule;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelRequirement_v1">
    <rdfs:label>Personnel requirement</rdfs:label>
    <rdfs:comment>The identification of the number, type, duration, and scheduling of specific certifications and job classifications needed to support the current operations request shall be presented as personnel requirements.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsTestRequirement_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelRequirementProperty_v1">
    <rdfs:label>Personnel requirement property</rdfs:label>
    <rdfs:comment>Specific properties that are required for personnel requirements shall be presented as personnel requirement properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelRequirementProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetRequirement_v1">
    <rdfs:label>Physical Asset requirement</rdfs:label>
    <rdfs:comment>Physical asset resources that are required for a operations segment shall be presented as physical asset specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsTestRequirement_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetRequirementProperty_v1">
    <rdfs:label>Physical Asset requirement property</rdfs:label>
    <rdfs:comment>Specific properties that are required for physical asset requirements shall be presented as physical asset requirement property(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetRequirementProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_RequestedSegmentResponse_v1">
    <rdfs:label>Requested segment response</rdfs:label>
    <rdfs:comment>The identification of the informaiton sent back as a result of the oprations request shall be presented as a requested segment response</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:RequestedSegmentResponse;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SegmentParameter_v1">
    <rdfs:label>Segment parameter</rdfs:label>
    <rdfs:comment>Specific parameters required for a segment requirement shall be presented as segment parameters.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SegmentParameter;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SegmentRequirement_v1">
    <rdfs:label>Segment requirement</rdfs:label>
    <rdfs:comment>An operations request shall be made up of one or more segment requirements. Each segment requirement shall correspond to, or reference, an identified operations definition, operations segment or process segment. T</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SegmentRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EvaluatedProperty_v1">
    <rdfs:label>Evaluated property</rdfs:label>
    <rdfs:comment>The evaluated property object identifies the set of testable object / testable object property pairs to be measured and the applicable test method to obtain a property measurement</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EvaluatedProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsTestRequirement_v1">
    <rdfs:label>Operations test requirement</rdfs:label>
    <rdfs:comment>The operations test requirements are represented as abstract interface objects to simplify the operations test model diagram</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsTestRequirement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PropertyMeasurement_v1">
    <rdfs:label>Property measurement</rdfs:label>
    <rdfs:comment>The measurement obtained during execution of work master (defined in Part 4 of this standard) shall be presented as a property measurement. A property measurement reports the measurement obtained for a single testable object property corresponding to an evaluated property of a test specification for a specific person, equipment, physical asset, material lot or material sublot</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PropertyMeasurement;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceActual_v1">
    <rdfs:label>Resource actual</rdfs:label>
    <rdfs:comment>/Abstract/ The resource actual represents an abstract interface object to simplify the operations test model diagram. The interface object represents the objects that can report test result(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceActual;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestResult_v1">
    <rdfs:label>Test result</rdfs:label>
    <rdfs:comment>The results from the test evaluation of property measurement of the testable object property of the testable object per the test specifications shall be presented as test results. A test result reports the measured results and evaluation of test specification criteria from a test for a specific person, piece of equipment, physical asset, material lot or material sublot</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestResult;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestSpecification_v1">
    <rdfs:label>Test specification</rdfs:label>
    <rdfs:comment>The test specification details the test specification criteria and the tested evaluated property(s) required for a testable object to match the quality or performance requirements of the business or particular customers</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestSpecificationCriteria_v1">
    <rdfs:label>Test specification criteria</rdfs:label>
    <rdfs:comment>The test specification criteria object defines the set of criterion to evaluate and the test result to be reported when a testable object satisfies those criteria.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestSpecificationCriteria;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestSpecificationProperty_v1">
    <rdfs:label>Test specification property</rdfs:label>
    <rdfs:comment>The test specification property object defines properties of the test specification. These properties are not the characteristics to be tested</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1">
    <rdfs:label>Testable object</rdfs:label>
    <rdfs:comment>The testable object and testable object property are represented as abstract interface objects to simplify the operations test model diagram. The interface objects represent the objects that are able to be tested by a test specification(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestableObject;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1">
    <rdfs:label>Testable object property</rdfs:label>
    <rdfs:comment>The testable object and testable object property are represented as abstract interface objects to simplify the operations test model diagram. The interface objects represent the objects that are able to be tested by a test specification(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:TestableObjectProperty;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Person_v1">
    <rdfs:label>Person</rdfs:label>
    <rdfs:comment>A  representation  of  a  specifically  identified  individual shall  be  presented  as  a person. A person may be a member of zero or more personnel classes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Person;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonProperty_v1">
    <rdfs:label>Person property</rdfs:label>
    <rdfs:comment>Properties  of  a person shall  be  presented as person  properties. Each person shall  have  zero  or more person properties. These specify the current property values of the person for the associated personnel class property. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelClass_v1">
    <rdfs:label>Personnel class</rdfs:label>
    <rdfs:comment>A representation of a grouping of persons with similar characteristics for a definite purpose such as manufacturing operations definition, scheduling, capability and performance shall be presented as a personnel class. Any person may be a member of zero or more personnel classes. A personnel class may be defined as a specialization of zero or more personnel class. A personnel class may be made up of zero or more personnel class(s).</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClass_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelClassProperty_v1">
    <rdfs:label>Personnel class property</rdfs:label>
    <rdfs:comment>Properties of a personnel class shall be presented as personnel class properties. Each personnel class shall have zero or more recognized properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClassProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Equipment_v1">
    <rdfs:label>Equipment</rdfs:label>
    <rdfs:comment>A representation of the elements of the equipment hierarchy model shown in ISA-95.00.01 shall be presented as equipment. Equipment may be a listing of any of the following: enterprise, site, area, work center, work unit, process cell, unit, production line, production unit, work cell, storage zone, and storage unit.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Equipment;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentAssetMapping_v1">
    <rdfs:label>Equipment asset mapping</rdfs:label>
    <rdfs:comment>The relationship between a physical asset and an equipment shall be presented as an equipment asset mapping. The equipment asset mapping records the time period when one equipment object and one physical asset object were associated.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentAssetMapping;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentClass_v1">
    <rdfs:label>Equipment class</rdfs:label>
    <rdfs:comment>A representation of a grouping of equipment with similar characteristics for a definite purpose such as manufacturing operations definition, scheduling, capability and performance shall be presented as an equipment class. Any piece of equipment may be a member of zero or more equipment classes. An equipment class may be defined as a specialization of zero or more equipment classes. An equipment class may be made up of zero or more equipment classes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClass_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentClassProperty_v1">
    <rdfs:label>Equipment class property</rdfs:label>
    <rdfs:comment>An equipment class property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result. The measured results may also be evaluated to the test specification criteria in the test specification that references the evaluated property where they may be recorded in an evaluated criterion result attribute in the test result. Equipment class properties may contain nested equipment class properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClassProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentProperty_v1">
    <rdfs:label>Equipment property</rdfs:label>
    <rdfs:comment>Properties of equipment shall be presented as equipment properties. An equipment shall have zero or more equipment properties. These specify the current property values of the equipment for the associated equipment class property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAsset_v1">
    <rdfs:label>Physical Asset</rdfs:label>
    <rdfs:comment>A physical piece of equipment shall be presented as a physical asset.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAsset;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetClass_v1">
    <rdfs:label>Physical Asset class</rdfs:label>
    <rdfs:comment>A representation of a grouping of physical assets with similar characteristics for purposes of repair and replacement shall be presented as a physical asset class. Any physical asset shall be a member of one physical asset class. A physical asset class may be defined as a specialization of zero or more physical asset classes. A physical asset class may be made up of zero or more physical asset classes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClass_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObject_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetClassProperty_v1">
    <rdfs:label>Physical Asset class property</rdfs:label>
    <rdfs:comment>Properties of a physical asset class shall be presented as physical asset class properties. Each may have zero or more recognized properties.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClassProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetProperty_v1">
    <rdfs:label>Physical Asset property</rdfs:label>
    <rdfs:comment>Properties of physical assets shall be presented as physical asset properties. A physical asset shall have zero or more physical asset properties. These specify the current property values of the physical asset for the associated physical asset class property. Physical asset properties may include a unit of measure. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_TestableObjectProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentSegmentSpecification_v1">
    <rdfs:label>Equipment segment specification</rdfs:label>
    <rdfs:comment>Equipment resources that are required for a process segment shall be presented as equipment segment specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentSegmentSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_EquipmentSegmentSpecificationProperty_v1">
    <rdfs:label>Equipment segment specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for equipment segment specifications shall be presented as equipment segment specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:EquipmentSegmentSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialSegmentSpecification_v1">
    <rdfs:label>Material segment specification</rdfs:label>
    <rdfs:comment>Material resources that are required for a process segment shall be presented as material segment specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialSegmentSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialSegmentSpecificationProperty_v1">
    <rdfs:label>Material segment specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for material segment specifications shall be presented as material segment specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialSegmentSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelSegmentSpecification_v1">
    <rdfs:label>Personnel segment specification</rdfs:label>
    <rdfs:comment>Personnel resources that are required for a process segment shall be presented as personnel segment specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelSegmentSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PersonnelSegmentSpecificationProperty_v1">
    <rdfs:label>Personnel segment specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for personnel segment specifications shall be presented as personnel segment specification properties</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PersonnelSegmentSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetSegmentSpecification_v1">
    <rdfs:label>Physical Asset segment specification</rdfs:label>
    <rdfs:comment>Physical asset resources that are required for a process segment shall be presented as physical asset segment specifications</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetSegmentSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_PhysicalAssetSegmentSpecificationProperty_v1">
    <rdfs:label>Physical Asset segment specification property</rdfs:label>
    <rdfs:comment>Specific properties that are required for physical asset segment specifications shall be presented as physical asset segment specification property(s)</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:PhysicalAssetSegmentSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProcessSegment_v1">
    <rdfs:label>Process segment</rdfs:label>
    <rdfs:comment>A process segment lists the classes of personnel, equipment, physical assets, and material needed, and/or it may present specific resources, such as specific equipment needed for the process segment. A process segment may list the quantity of the resource needed. A process segment is something that occurs or can occur during manufacturing operations</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProcessSegment;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProcessSegmentDependency_v1">
    <rdfs:label>Segment dependency</rdfs:label>
    <rdfs:comment>Process dependencies that are independent of any particular product or operations task shall be presented as segment dependencies.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProcessSegmentDependency;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProcessSegmentParameter_v1">
    <rdfs:label>Process segment parameter</rdfs:label>
    <rdfs:comment>Specific parameters required for a process segment shall be presented as process segment parameters. Process segment parameters may contain nested process segment parameters</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProcessSegmentParameter;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_FromResourceReference_v1">
    <rdfs:label>From resource reference</rdfs:label>
    <rdfs:comment>A 'from' reference to a resource shall be defined as a from resource reference.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:FromResourceReference;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_FromResourceReferenceProperty_v1">
    <rdfs:label>From resource reference property</rdfs:label>
    <rdfs:comment>A 'from' reference to a resource shall be defined as a from resource reference.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:FromResourceReferenceProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceNetworkConnection_v1">
    <rdfs:label>Resource network connection</rdfs:label>
    <rdfs:comment>The directed relationship between two resources in a resource relationship network shall be defined as a resource network connection.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceNetworkConnection;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceNetworkConnectionProperty_v1">
    <rdfs:label>Resource network connection property</rdfs:label>
    <rdfs:comment>A property of a resource network connection shall be defined as a resource network connection property. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceNetworkConnectionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceNetworkConnectionType_v1">
    <rdfs:label>Resource network connection type</rdfs:label>
    <rdfs:comment>A definition of a type of a resource network connection shall be defined as a resource network connection type.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceNetworkConnectionType;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceNetworkConnectionTypeProperty_v1">
    <rdfs:label>Resource network connection type property</rdfs:label>
    <rdfs:comment>A 'from' reference to a resource shall be defined as a from resource reference.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceNetworkConnectionTypeProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceRelationshipNetwork_v1">
    <rdfs:label>Resource relationship network</rdfs:label>
    <rdfs:comment>A resource relationship network shall be a composition of one or more resource network connections.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceRelationshipNetwork;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceRelationshipNetworkProperty_v1">
    <rdfs:label>Resource relationship network property</rdfs:label>
    <rdfs:comment>A resource relationship network property may contain nested resource relationship network property(s).</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceRelationshipNetworkProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ToResourceReference_v1">
    <rdfs:label>To resource reference</rdfs:label>
    <rdfs:comment>A 'to' reference to a resource shall be defined as a to resource reference.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ToResourceReference;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ToResourceReferenceProperty_v1">
    <rdfs:label>To resource reference property</rdfs:label>
    <rdfs:comment>A 'to' reference to a resource shall be defined as a to resource reference.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ToResourceReferenceProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkAlert_v1">
    <rdfs:label>Work alert</rdfs:label>
    <rdfs:comment>A notification of a Level 3 event shall be defined as a work alert.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkAlert;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkAlertDefinition_v1">
    <rdfs:label>Work alert definition</rdfs:label>
    <rdfs:comment>A notification of a Level 3 event shall be defined as a work alert. Alert definition are the class of Wor Alert</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkAlertDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkAlertDefinitionProperty_v1">
    <rdfs:label>Work alert definition property</rdfs:label>
    <rdfs:comment>The work alert definition property shall be defined as property on a work alert definition property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkAlertDefinitionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkAlertProperty_v1">
    <rdfs:label>Work alert property</rdfs:label>
    <rdfs:comment>The work alert property shall be defined as property on a work alert property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkAlertProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendar_v1">
    <rdfs:label>Work calendar</rdfs:label>
    <rdfs:comment>A notification of a Level 3 event shall be defined as a work calendar.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendar;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarDefinition_v1">
    <rdfs:label>Work calendar definition</rdfs:label>
    <rdfs:comment>The work calendar definition shall be defined as a collection of work calendar definition entries.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarDefinitionEntry_v1">
    <rdfs:label>Work calendar definition entry</rdfs:label>
    <rdfs:comment>The work calendar shall be defined as a set of start, duration, and recurrence rules that can be used to create work calendar entries of a specific type.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarDefinitionEntry;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarDefinitionEntryProperty_v1">
    <rdfs:label>Work calendar definition entry property</rdfs:label>
    <rdfs:comment>The work calendar definition entry property shall be defined as property on a work calendar definition entry.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarDefinitionEntryProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarDefinitionProperty_v1">
    <rdfs:label>Work calendar definition property</rdfs:label>
    <rdfs:comment>The work calendar definition property shall be defined as property on a work calendar definition property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarDefinitionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarEntry_v1">
    <rdfs:label>Work calendar entry</rdfs:label>
    <rdfs:comment>The work calendar entry shall be defined as a calendar entry with a start date and time, a finish date and time, and an entry type.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarEntry;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarEntryProperty_v1">
    <rdfs:label>Work calendar entry property</rdfs:label>
    <rdfs:comment>The work calendar entry property shall be defined as a property on a work calendar entry.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarEntryProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCalendarProperty_v1">
    <rdfs:label>Work calendar property</rdfs:label>
    <rdfs:comment>The work calendar property shall be defined as property on a work definition property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCalendarProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCapability_v1">
    <rdfs:label>Work capability</rdfs:label>
    <rdfs:comment>The collection of information about the resources for work for selected future and past times shall be defined as work capability.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkMasterCapability_v1">
    <rdfs:label>Work master capability</rdfs:label>
    <rdfs:comment>Work master capability has an equivalent structure to the personnel, equipment and material structure of work capability, except the work master capability is defined for a specific work master.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkMasterCapability;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkDefinition_v1">
    <rdfs:label>Work definition</rdfs:label>
    <rdfs:comment>/Abstract/ An identification of the resources and workflow required to perform a specified unit of work shall be defined as a work definition</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkDefinition;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkDirective_v1">
    <rdfs:label>Work directive</rdfs:label>
    <rdfs:comment>The resources and instructions required to perform a unit of work for a specific job order shall be defined as a work directive.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkDirective;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkDefinition_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkMaster_v1">
    <rdfs:label>Work master</rdfs:label>
    <rdfs:comment>The resources and instructions required to perform a unit of work without reference to a specific job order shall be defined as a work master</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkMaster;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkDefinition_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobResponse_v1">
    <rdfs:label>Job response</rdfs:label>
    <rdfs:comment>The responses from manufacturing that are associated with a job order shall be defined as a job response.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobResponse;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobResponseData_v1">
    <rdfs:label>Job response data</rdfs:label>
    <rdfs:comment>Other information related to the actual work made shall be presented as job response data.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobResponseData;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobResponseList_v1">
    <rdfs:label>Job response list</rdfs:label>
    <rdfs:comment>A job response list shall be defined as a collection of job responses for a specific period of time and selected work centers or other resources.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobResponseList;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkPerformance_v1">
    <rdfs:label>Work performance</rdfs:label>
    <rdfs:comment>Work performance shall be defined as a collection of work responses that is a report on requested manufacturing information.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkPerformance;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkResponse_v1">
    <rdfs:label>Work response</rdfs:label>
    <rdfs:comment>The responses from manufacturing that are associated with a work request shall be defined as work responses.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkResponse;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkRecord_v1">
    <rdfs:label>Work record</rdfs:label>
    <rdfs:comment>The work record shall be defined as a subset of the execution and business information that is retained based upon business requirements identified by a work record specification.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkRecord;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkRecordEntry_v1">
    <rdfs:label>Work record entry</rdfs:label>
    <rdfs:comment>The work record entry object shall be a single information object as an object defined in Part 2 and Part 4, and any third-party manufacturing work message profile within a work record .</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkRecordEntry;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkRecordSpecification_v1">
    <rdfs:label>Work record specification</rdfs:label>
    <rdfs:comment>Specification of the allowed content of work record objects shall be defined as work record specifications.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkRecordSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobList_v1">
    <rdfs:label>Job list</rdfs:label>
    <rdfs:comment>A job list shall be defined as a collection of job orders for a specific period of time and selected work centers or other resources</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobList;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobOrder_v1">
    <rdfs:label>Job order</rdfs:label>
    <rdfs:comment>The unit of work requested for execution in a job list and a work request shall be defined as a job order. A job order references an associated work master.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobOrder;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_JobOrderParameter_v1">
    <rdfs:label>Job order parameter</rdfs:label>
    <rdfs:comment>Specific parameters required for a job order shall be presented as job order parameters.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:JobOrderParameter;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkRequest_v1">
    <rdfs:label>Work request</rdfs:label>
    <rdfs:comment>A request for work defined by a set of job orders shall be defined as a work request.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkRequest;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkSchedule_v1">
    <rdfs:label>Work schedule</rdfs:label>
    <rdfs:comment>A request for work shall be listed as a work schedule. A work schedule shall be made up of one or more work requests.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkSchedule;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecification_v1">
    <rdfs:label>Workflow specification</rdfs:label>
    <rdfs:comment>A workflow specification shall be defined as a collection of workflow specification nodes and workflow specification connections.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecification;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationConnection_v1">
    <rdfs:label>Workflow specification connection</rdfs:label>
    <rdfs:comment>A workflow specification connection represents a many-to-many link between workflow specification nodes.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationConnection;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationConnectionProperty_v1">
    <rdfs:label>Workflow specification connection property</rdfs:label>
    <rdfs:comment>A property of a workflow specification connection shall be defined as a workflow specification connection property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationConnectionType_v1">
    <rdfs:label>Workflow specification connection type</rdfs:label>
    <rdfs:comment>A workflow specification connection type defines the properties that can be associated with a specific workflow specification connection.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionType;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationConnectionTypeProperty_v1">
    <rdfs:label>Workflow specification connection type property</rdfs:label>
    <rdfs:comment>A property of a workflow specification connection type shall be defined as a workflow specification connection type property. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionTypeProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationNode_v1">
    <rdfs:label>Workflow specification node</rdfs:label>
    <rdfs:comment>A workflow specification node is a step in a workflow.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationNodeProperty_v1">
    <rdfs:label>Workflow specification node property</rdfs:label>
    <rdfs:comment>A property of a workflow specification node shall be defined as a workflow specification node property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationNodeProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationNodeType_v1">
    <rdfs:label>Workflow specification node type</rdfs:label>
    <rdfs:comment>A workflow specification node type defines the properties that can be associated with a specific workflow specification node.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationNodeType;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationNodeTypeProperty_v1">
    <rdfs:label>Workflow specification node type property</rdfs:label>
    <rdfs:comment>A property of a workflow specification node type shall be defined as a workflow specification node type property.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationNodeTypeProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkflowSpecificationProperty_v1">
    <rdfs:label>Workflow specification property</rdfs:label>
    <rdfs:comment>A property of a workflow specification shall be defined as a workflow specification property. A workflow specification property may contain nested workflow specification property(s).</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkflowSpecificationProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Resource_v1">
    <rdfs:label>Resource</rdfs:label>
    <rdfs:comment>Abstract model for all resource models (person, equipment, physical asset, material definition, material lot, material sublot, work master, process segment, operation definition, operational location, operations segment, test specification, test result)</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Resource;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClass_v1">
    <rdfs:label>Resource class</rdfs:label>
    <rdfs:comment>Abstract model for all resource class models (person class, equipment class, physical asset class, material class)</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceClass;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceClassProperty_v1">
    <rdfs:label>Resource class property</rdfs:label>
    <rdfs:comment>Abstract model for all resource class property models (person class, equipment class, physical asset class, material class)</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceClassProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ResourceProperty_v1">
    <rdfs:label>Resource property</rdfs:label>
    <rdfs:comment>Abstract model for all resource property models (person, equipment, physical asset, material definition, material lot, material sublot, work master, process segment, operation definition, operational location, operations segment, test specification, test result)</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ResourceProperty;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SpatialDefinition_v1">
    <rdfs:label>Spatial definition</rdfs:label>
    <rdfs:comment>The spatial definition provides a means of communicating zero-dimensional point, one-dimensional line, or two-dimensional shape or three-dimensional solid geospatial location data for planning/scheduling, actuals, resources, and analytics.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SpatialDefinition;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Area_v1">
    <rdfs:label>Area</rdfs:label>
    <rdfs:comment>An area is a physical, geographical, or logical grouping determined by the site. It may contain work centers such as process cells, production units, production lines, and storage zones. Most Level 3 functions occur within the area. The main production capability and geographical location within a site usually identify areas. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Area;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Enterprise_v1">
    <rdfs:label>Enterprise</rdfs:label>
    <rdfs:comment>An enterprise is a collection of sites and areas and represents the top level of a role based equipment hierarchy. The enterprise is responsible for determining what products will be manufactured, at which sites they will be manufactured, and in general how they will be manufactured. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Enterprise;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProcessCell_v1">
    <rdfs:label>Process cell</rdfs:label>
    <rdfs:comment>Process cells and units are the lowest level of equipment typically scheduled by the Level 4 and Level 3 functions for batch manufacturing processes. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProcessCell;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCenter_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProductionLine_v1">
    <rdfs:label>Production line</rdfs:label>
    <rdfs:comment>Production lines and work cells are the lowest levels of equipment typically scheduled by the Level 4 or Level 3 functions for discrete manufacturing processes. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProductionLine;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCenter_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ProductionUnit_v1">
    <rdfs:label>Production unit</rdfs:label>
    <rdfs:comment>A production unit generally encompasses all of the equipment required for a segment of continuous production that operates in a relatively autonomous manner. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ProductionUnit;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCenter_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Site_v1">
    <rdfs:label>Site</rdfs:label>
    <rdfs:comment>A site is a physical, geographical, or logical grouping determined by the enterprise. It may contain areas, production lines, process cells, and production units. The Level 4 functions at a site are involved in local site management and optimization. Site planning and scheduling may involve work centers or work units within the areas. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Site;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1">
    <rdfs:label>Site asset</rdfs:label>
    <rdfs:comment>An Abstract site asset in the physical asset equipment hierarchy</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:SiteAsset;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_StorageUnit_v1">
    <rdfs:label>Storage unit</rdfs:label>
    <rdfs:comment>Storage zones and storage units are the lowest level of material movement equipment typically scheduled by the Level 4 and Level 3 functions for discrete, batch and continuous manufacturing processes. A storage zone is a type of work center and a storage unit is a type of work unit that is organized as elements within an area. These are the lower-level elements of an equipment hierarchy used in material storage and movement activities. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:StorageUnit;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkUnit_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_StorageZone_v1">
    <rdfs:label>Storage zone</rdfs:label>
    <rdfs:comment>Storage zones and storage units are the lowest level of material movement equipment typically scheduled by the Level 4 and Level 3 functions for discrete, batch and continuous manufacturing processes. A storage zone is a type of work center and a storage unit is a type of work unit that is organized as elements within an area. These are the lower-level elements of an equipment hierarchy used in material storage and movement activities. </rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:StorageZone;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCenter_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_Unit_v1">
    <rdfs:label>Unit</rdfs:label>
    <rdfs:comment>Units have well-defined processing capabilities and throughput capacities and these are used for Level 3 functions. T</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:Unit;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkUnit_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCell_v1">
    <rdfs:label>Work cell</rdfs:label>
    <rdfs:comment>Work cells are usually only identified when there is flexibility in the routing of work within a production line.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCell;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkUnit_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkCenter_v1">
    <rdfs:label>Work center</rdfs:label>
    <rdfs:comment>Work centers are elements of the equipment hierarchy under an area. The term work center may be used when the specific type of the equipment element is not significant for the purpose of the discussion.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkCenter;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_WorkUnit_v1">
    <rdfs:label>Work unit</rdfs:label>
    <rdfs:comment>A work unit is any element of the equipment hierarchy under a work center. Work units are the lowest form of elements in an equipment hierarchy that are typically scheduled by Level 3 functions.</rdfs:comment>
    <isa95:sourceComment>According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:WorkUnit;1</isa95:sourceDtmi>
    <rdfs:subClassOf rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_SiteAsset_v1"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_LangStringSet_v1">
    <rdfs:label>Language String Set</rdfs:label>
    <rdfs:comment>A set of strings, each annotated by the language of the string. The meaning of the string in each language shall be the same.</rdfs:comment>
    <isa95:sourceComment>Not part of the ISA95 standard. But enables multi language strings</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:LangStringSet;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ext_Tags_v1">
    <rdfs:label>Tags</rdfs:label>
    <rdfs:comment>You can use the concept of tags to further identify and categorize your digital twins</rdfs:comment>
    <isa95:sourceComment>Not part of the AAS meta model. Makes querying easier. See https://docs.microsoft.com/en-us/azure/digital-twins/how-to-use-tags</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:ext:Tags;1</isa95:sourceDtmi>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1__ID">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>ID</rdfs:label>
    <rdfs:comment>Objects in the information model which require unique identifications contain an ID attribute, which are unique within the scope of the exchanged information</rdfs:comment>
    <isa95:sourceComment>According to 4.5.5.1 Object identification in ANSI/ISA-95.00.02-2018</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:BaseModel;1#ID</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1__tags">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_BaseModel_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_ext_Tags_v1"/>
    <rdfs:label>tags</rdfs:label>
    <isa95:sourceComment>Not part of the ISA-95 standard. Makes querying easier. See https://docs.microsoft.com/en-us/azure/digital-twins/how-to-use-tags</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:BaseModel;1#tags</isa95:sourceDtmi>
    <isa95:dtdlType>Component</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1__contains">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
    <rdfs:label>Contains</rdfs:label>
    <rdfs:comment>The child hierarchy scope(s) contained within this hierarchy scope.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:HierarchyScope;1#contains</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1__equipmentID">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Equipment ID</rdfs:label>
    <rdfs:comment> unique identification of an equipment element</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:HierarchyScope;1#equipmentID</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1__equipmentLevel">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Equipment level</rdfs:label>
    <rdfs:comment>An identification of the level in the role-based equipment hierarchy</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:HierarchyScope;1#equipmentLevel</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__includesPropertiesOf">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:label>Includes properties of</rdfs:label>
    <rdfs:comment>This material class(s) include properties of the material class.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#includesPropertiesOf</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__IsAssembledFrom">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
