    <rdfs:label>Corresponds to an entry in</rdfs:label>
    <rdfs:comment>The reference to external data (information object) which is stored external to this operations record entry template. If data is embedded in this operations record entry template, the attribute is not used. The format of the reference is specified in the operations record specification template</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1#correspondsToAnExternalEntryIn</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__description">
