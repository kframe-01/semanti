  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1__correspondsToAnExternalEntryIn">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_OperationsRecordEntryTemplate_v1"/>
