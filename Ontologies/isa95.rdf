    <rdfs:comment>Additional information about the material class.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#description</isa95:sourceDtmi>
    <isa95:dtdlType>Component</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__hierarchyScope">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Hierarchy scope</rdfs:label>
    <rdfs:comment>Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined.</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#hierarchyScope</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__hierarchyScopeRel">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_HierarchyScope_v1"/>
    <rdfs:label>fits hierarchy scope</rdfs:label>
    <rdfs:comment>Optional relationship to hierarchy.</rdfs:comment>
    <isa95:sourceComment>Not part of the Standard Specs.</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#hierarchyScopeRel</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__assemblyType">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Assembly type</rdfs:label>
    <rdfs:comment>Defines the type of the assembly</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#assemblyType</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1__assemblyRelationship">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClass_v1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>Assembly relationship</rdfs:label>
    <rdfs:comment>Defines the type of the relationships</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClass;1#assemblyRelationship</isa95:sourceDtmi>
    <isa95:dtdlType>Property</isa95:dtdlType>
    <isa95:writable>True</isa95:writable>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClassProperty_v1__contains">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClassProperty_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialClassProperty_v1"/>
    <rdfs:label>Contains</rdfs:label>
    <rdfs:comment>The nested material class property(s) makes up part of this material class property as the whole</rdfs:comment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialClassProperty;1#contains</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1__isAssembledFrom">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1"/>
    <rdfs:label>Is assembled from</rdfs:label>
    <rdfs:comment>This material definition is part of the related object as the whole</rdfs:comment>
    <isa95:sourceComment>Relationship type: Composition</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:MaterialDefinition;1#isAssembledFrom</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1__hasPropertiesOf">
    <rdfs:domain rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinition_v1"/>
    <rdfs:range rdf:resource="https://w3id.org/trumpf/isa95/digitaltwins_isa95_MaterialDefinitionProperty_v1"/>
