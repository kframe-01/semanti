    <isa95:sourceComment>Mandatory</isa95:sourceComment>
    <isa95:sourceDtmi>dtmi:digitaltwins:isa95:OperationsRecordTemplate;1#specifiedBy</isa95:sourceDtmi>
    <isa95:dtdlType>Relationship</isa95:dtdlType>
